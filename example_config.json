{
	"Redirects": [
		{
			"Name": "demo",
			"From": "/secure/:token/demo/*api",
			"To": "http://localhost:94/",
			"Tipe": "GET"
		}
	],
	"Port": 80,
	"BaseUrl": "https://www.mydomain.com/secure/",
	"HostNames": [
		"www.mydomain.com"
	],
	"LogFile": "accessLog",
	"Secure": true,
	"MaxBodyBytes": 33554432,
	"UpstreamTimeoutSeconds": 30
}
